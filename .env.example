# URL publique du site (utilisée pour les métadonnées SEO et OpenGraph).
# À définir lors du déploiement (ex. https://tivaouane-ai.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Assistant IA (API /api/chat) ---

# Clé API du fournisseur du modèle de langage (requise pour l’assistant).
# À copier dans .env.local, jamais committée.
OPENAI_API_KEY=

# URL de base de l’API, compatible « chat completions » (optionnelle).
# Peut pointer vers un autre fournisseur compatible OpenAI.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Identifiant du modèle (optionnel).
# OPENAI_MODEL=gpt-4o-mini

# Température de génération, entre 0 et 1 (optionnelle, défaut : 0.2).
# OPENAI_TEMPERATURE=0.2

# Nombre maximal de jetons générés (optionnel, défaut : 1024).
# OPENAI_MAX_TOKENS=1024

# Modèle d’embeddings pour la recherche sémantique (optionnel, défaut :
# text-embedding-3-small). Sans clé API valide, la recherche retombe sur le
# BM25 seul, sans nécessiter cette variable.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small